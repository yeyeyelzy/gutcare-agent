# Reference only. Create .env manually with unique local-only credentials before running scripts/dev-up.ps1.
POSTGRES_DB=gutcare_business
POSTGRES_BOOTSTRAP_USER=gutcare_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_LOCAL_BOOTSTRAP_SECRET
GUTCARE_MIGRATOR_PASSWORD=CHANGE_ME_LOCAL_MIGRATOR_SECRET
GUTCARE_APP_PASSWORD=CHANGE_ME_LOCAL_APP_SECRET
GUTCARE_WORKER_PASSWORD=CHANGE_ME_LOCAL_WORKER_SECRET
GUTCARE_ANALYSIS_WORKER_PASSWORD=CHANGE_ME_LOCAL_ANALYSIS_WORKER_SECRET
GUTCARE_NOTIFICATION_WORKER_PASSWORD=CHANGE_ME_LOCAL_NOTIFICATION_WORKER_SECRET
MIGRATOR_DATABASE_URL=postgresql+psycopg://gutcare_migrator:CHANGE_ME@localhost:5432/gutcare_business
DATABASE_URL=postgresql+psycopg://gutcare_app:CHANGE_ME@localhost:5432/gutcare_business
WORKER_DATABASE_URL=postgresql+psycopg://gutcare_worker:CHANGE_ME@localhost:5432/gutcare_business
MEDICATION_WORKER_DATABASE_URL=postgresql+psycopg://gutcare_worker:CHANGE_ME@localhost:5432/gutcare_business
NOTIFICATION_WORKER_DATABASE_URL=postgresql+psycopg://gutcare_notification_worker:CHANGE_ME@localhost:5432/gutcare_business
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
AUTH_EMAIL_LOOKUP_PEPPER=
# URL-safe Base64 encoding of 32 random bytes; use a distinct production secret.
AUTH_EMAIL_ENCRYPTION_KEY=
# Use a distinct high-entropy signing key; never reuse the lookup pepper.
AUTH_JWT_SIGNING_KEY=
# Development/test only values generated from contracts/consent/registration-notices.json.
# Production must replace all four atomically from a legally approved artifact; test-only versions fail startup.
PRIVACY_POLICY_SUMMARY_HASH=e17c133d1e39a51c8b4370fce470196f24b50ec099edbd1d7f6dedd4c8672991
PRIVACY_POLICY_VERSION=test-only-privacy-v1
HEALTH_DATA_PROCESSING_SUMMARY_HASH=c3c38f369746498cab3b6e9c96bfda09c42230e44e257d56dc47c972e5139be1
HEALTH_DATA_PROCESSING_POLICY_VERSION=test-only-health-v1
# F14 mood-record processing and AI-sharing notices are separately versioned and hashed.
MOOD_DATA_PROCESSING_SUMMARY_HASH=
MOOD_DATA_PROCESSING_POLICY_VERSION=
MOOD_AI_SHARING_SUMMARY_HASH=
MOOD_AI_SHARING_POLICY_VERSION=
# Independent high-entropy key for mood create idempotency HMACs; do not reuse auth/privacy keys.
MOOD_IDEMPOTENCY_HMAC_KEY=
# Separate SHA-256 notice-summary hashes for each optional consent purpose.
SENSITIVE_IMAGE_SUMMARY_HASH=
SENSITIVE_IMAGE_POLICY_VERSION=
THIRD_PARTY_AI_SUMMARY_HASH=
THIRD_PARTY_AI_POLICY_VERSION=
PUSH_NOTIFICATION_SUMMARY_HASH=
PUSH_NOTIFICATION_POLICY_VERSION=
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SENDER=no-reply@gutcare.invalid
MAIL_STARTTLS=false
MINIO_ROOT_USER=gutcare-local
MINIO_ROOT_PASSWORD=
FILES_ENDPOINT=http://minio:9000
FILES_PUBLIC_URL=https://api.example.invalid
FILES_ACCESS_KEY=
FILES_SECRET_KEY=
FILES_BUCKET=gutcare-files
FILES_CAPABILITY_SECRET=
AGENT_SERVICE_TOKEN=
FILES_CLAMAV_HOST=clamav
FILES_CLAMAV_PORT=3310
FILES_CLAMAV_TIMEOUT_SECONDS=30
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GATEWAY_HTTP_PORT=8080
MINIO_SOURCE_COMMIT=
MINIO_IMAGE_DIGEST=
