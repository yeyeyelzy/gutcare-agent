{
  "name": "gutcare-mobile",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "build:android": "uni build -p app-android",
    "build:ios": "uni build -p app-ios",
    "typecheck": "vue-tsc --noEmit",
    "openapi:generate": "node scripts/openapi-types.mjs --write",
    "openapi:check": "node scripts/openapi-types.mjs --check",
    "check": "pnpm openapi:check && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-app-plus": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-ui": "1.5.11",
    "pinia": "3.0.3",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.15",
    "@dcloudio/uni-uts-v1": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "@types/node": "22.15.30",
    "openapi-typescript": "7.13.0",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "vite": "5.4.19",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.10",
    "yaml": "2.9.1"
  }
}
