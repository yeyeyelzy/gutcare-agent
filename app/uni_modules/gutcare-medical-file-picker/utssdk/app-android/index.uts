import Activity from 'android.app.Activity'
import Context from 'android.content.Context'
import Intent from 'android.content.Intent'
import Uri from 'android.net.Uri'
import OpenableColumns from 'android.provider.OpenableColumns'
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import UUID from 'java.util.UUID'
import { UTSAndroid } from 'io.dcloud.uts'
import type { MedicalPickerFailure, MedicalPickerMime, PickedMedicalFile } from '../interface.uts'

const REQUEST_CODE = 28417
const PREFIX = 'gutcare-medical-'
const PDF_LIMIT = 20 * 1024 * 1024
const IMAGE_LIMIT = 10 * 1024 * 1024
let pending = false

function fail(reason: MedicalPickerFailure): void {
  pending = false
  UTSAndroid.offAppActivityResult(resultCallback)
  failureCallback?.(reason)
  successCallback = null
  failureCallback = null
}
let successCallback: ((file: PickedMedicalFile) => void) | null = null
let failureCallback: ((reason: MedicalPickerFailure) => void) | null = null

function safeName(value: string): string {
  const base = value.split('/').pop()?.split('\\').pop() ?? ''
  const clean = base.replace(/[^A-Za-z0-9._-]/g, '_').slice(-180)
  return clean.length > 0 ? clean : 'medical-file'
}
function mimeFor(name: string, mime: string | null): MedicalPickerMime | null {
  const type = (mime ?? '').toLowerCase()
  const extensionType: MedicalPickerMime | null = name.toLowerCase().endsWith('.pdf') ? 'application/pdf'
    : name.toLowerCase().endsWith('.jpg') || name.toLowerCase().endsWith('.jpeg') ? 'image/jpeg'
      : name.toLowerCase().endsWith('.png') ? 'image/png' : null
  const providerType: MedicalPickerMime | null = type == 'application/pdf' ? 'application/pdf'
    : type == 'image/jpeg' ? 'image/jpeg' : type == 'image/png' ? 'image/png' : null
  if (extensionType != null && providerType != null && extensionType != providerType) return null
  return providerType ?? extensionType
}
function copyFromProvider(uri: Uri): PickedMedicalFile {
  const context = UTSAndroid.getAppContext() as Context
  const resolver = context.getContentResolver()
  var displayName = 'medical-file'
  const cursor = resolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)
  if (cursor != null) {
    try { if (cursor.moveToFirst()) displayName = cursor.getString(0) ?? displayName } finally { cursor.close() }
  }
  const name = safeName(displayName)
  const mime = mimeFor(name, resolver.getType(uri))
  if (mime == null) throw new Error('unsupported_type')
  const extension = mime == 'application/pdf' ? 'pdf' : mime == 'image/jpeg' ? 'jpg' : 'png'
  const destination = new File(context.getCacheDir(), PREFIX + UUID.randomUUID().toString() + '.' + extension)
  const input = resolver.openInputStream(uri)
  if (input == null) throw new Error('unavailable')
  let output: FileOutputStream | null = null
  let total = 0
  const max = mime == 'application/pdf' ? PDF_LIMIT : IMAGE_LIMIT
  try {
    const stream = new FileOutputStream(destination, false)
    output = stream
    const buffer = ByteArray(16 * 1024)
    while (true) {
      const count = input.read(buffer)
      if (count < 0) break
      total += count
      if (total > max) throw new Error('too_large')
      stream.write(buffer, 0, count)
    }
    stream.flush()
  } catch (error: any) {
    destination.delete()
    throw error
  } finally {
    output?.close()
    input.close()
  }
  if (total <= 0) { destination.delete(); throw new Error('unavailable') }
  return { path: destination.absolutePath, name, size: total, mime }
}

const resultCallback = (requestCode: Int, resultCode: Int, data?: Intent): void => {
  if (requestCode != REQUEST_CODE || !pending) return
  if (resultCode != Activity.RESULT_OK || data == null || data.data == null) { fail('cancelled'); return }
  try {
    const file = copyFromProvider(data.data as Uri)
    pending = false
    UTSAndroid.offAppActivityResult(resultCallback)
    successCallback?.(file)
    successCallback = null
    failureCallback = null
  } catch (error: any) {
    const message = error?.message ?? ''
    fail(message == 'unsupported_type' ? 'unsupported_type' : message == 'too_large' ? 'too_large' : 'unavailable')
  }
}

export function chooseMedicalFile(success: (file: PickedMedicalFile) => void, failure: (reason: MedicalPickerFailure) => void): void {
  if (pending) { failure('unavailable'); return }
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) { failure('unavailable'); return }
  pending = true
  successCallback = success
  failureCallback = failure
  UTSAndroid.onAppActivityResult(resultCallback)
  try {
    const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT)
    intent.addCategory(Intent.CATEGORY_OPENABLE)
    intent.setType('*/*')
    intent.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf('application/pdf', 'image/jpeg', 'image/png'))
    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
    activity.startActivityForResult(intent, REQUEST_CODE)
  } catch (_error) { fail('unavailable') }
}

export function cleanupMedicalFile(path: string): void {
  const context = UTSAndroid.getAppContext() as Context
  const cache = context.getCacheDir().getCanonicalPath()
  const file = new File(path)
  if (!file.getCanonicalPath().startsWith(cache + File.separator) || !file.getName().startsWith(PREFIX)) return
  if (file.exists()) file.delete()
}
